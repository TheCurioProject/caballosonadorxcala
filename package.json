{
  "name": "hotelsonador",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/generate-prisma.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/generate-prisma.mjs",
    "smoobu:migrate": "node scripts/migrate-bookings-to-smoobu.mjs",
    "test:smoobu-migration": "node --test scripts/smoobu-migration.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.cjs scripts/*.test.mjs",
    "check:production": "node scripts/check-production.mjs",
    "test:cala": "vitest run --config vitest.cala.config.ts",
    "test:integration": "node --test scripts/*.test.cjs scripts/*.test.mjs && vitest run --config vitest.cala.config.ts",
    "db:export": "node scripts/site-data.mjs export",
    "db:import": "node scripts/site-data.mjs import",
    "db:validate": "node scripts/site-data.mjs validate",
    "db:setup-lodgings": "node scripts/setup-lodgings.mjs",
    "test:browser": "node scripts/test-site-browser.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.5.1",
    "autoprefixer": "^10.5.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.0.0",
    "d3-interpolate": "^3.0.1",
    "date-fns": "^4.4.0",
    "flubber": "^0.4.2",
    "framer-motion": "^12.42.0",
    "ical-generator": "^11.0.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.21.0",
    "next": "^16.4.5",
    "node-ical": "^0.26.1",
    "postcss": "^8.5.32",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "resend": "^6.16.0",
    "stripe": "^22.3.0",
    "tailwindcss": "^3.4.19",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "d3-interpolate-path": "^2.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "glob": "^14.0.4",
    "prisma": "^5.22.0",
    "sharp": "^0.35.5",
    "svg-path-bbox": "^2.1.0",
    "svg-path-properties": "^2.0.2",
    "svgpath": "^2.6.0",
    "typescript": "^5",
    "vercel": "^65.12.1",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@axe-core/playwright": "^4.13.0",
    "vitest": "^5.0.1",
    "tsx": "^4.23.15",
    "prettier": "^3.9.8"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "tar": "^7.5.22",
    "brace-expansion@<2": "^1.1.21",
    "js-yaml@^4.0.0": "^4.3.2",
    "path-to-regexp@^6.0.0": "^6.3.0",
    "path-to-regexp@^8.0.0": "^8.4.0"
