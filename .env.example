# ===================================================
# Hotel Soñador — Environment Variables
# ===================================================
# Copy this file to .env and fill in each value.
# NEVER commit .env to version control.
# ===================================================

# ─── Database (MySQL — HostGator / phpMyAdmin) ───
# Format: mariadb://USUARIO:CONTRASEÑA@SERVIDOR:3306/NOMBRE_DB
# Example: mariadb://hotelson_admin:MiPassword123@gator1234.hostgator.com:3306/hotelson_db
DATABASE_URL=""

# ─── Stripe (Production / Live) ─────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Webhook signing secret (from Stripe Dashboard → Webhooks → your endpoint)
STRIPE_WEBHOOK_SECRET=""

# ─── App ─────────────────────────────────────────
# Base path for public assets (leave empty for root deployments)
NEXT_PUBLIC_BASE_PATH=""

# ─── Security (REQUIRED in production) ───────────
# JWT secret for admin session tokens (generate a random 64-char string)
JWT_SECRET=""

# Default admin password for initial system setup (CHANGE IMMEDIATELY after first login)
ADMIN_DEFAULT_PASSWORD=""

# ─── Email (Resend) ──────────────────────────────
RESEND_API_KEY=""

# ─── Scheduled jobs (required) ────────────────────
# Generate a random secret; configure the same value in Vercel and GitHub Secrets.
# GitHub Secrets also needs PRODUCTION_URL (https://your-domain).
CRON_SECRET=""

# ─── Cloudinary (images and private identification) ───
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME — keep this value server-only.
CLOUDINARY_URL=""

# CALA / Supabase. Copy the real values from your own project; never commit secrets.
# Keep legacy until the import, bootstrap and reconciliation are complete.
DATA_BACKEND=legacy
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternative for older projects: NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_DATABASE_URL=
# Local migration tooling only; do not deploy the owner connection:
SUPABASE_DIRECT_URL=
CALA_ORGANIZATION_ID=
CALA_DEFAULT_PROPERTY_ID=
# Server only (team invitations from CALA). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional fallback recipient for booking notifications.
BOOKING_ADMIN_EMAIL=
# Follow docs/SUPABASE_SETUP.md before enabling DATA_BACKEND=supabase.
